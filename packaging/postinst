#!/bin/sh
set -eu

INSTALL_DIR=/opt/luxai/s2s-magpie
VENV_DIR="$INSTALL_DIR/.venv"
UV="$INSTALL_DIR/bin/uv"
LOCK_FILE="$INSTALL_DIR/packages/requirements-jetson.lock.txt"
SERVICE=luxai-s2s-magpie.service
UV_CACHE_DIR="$INSTALL_DIR/.uv-cache"
UPGRADE_STATE_DIR=/run/luxai-s2s-magpie-package
export UV_CACHE_DIR

cleanup_uv_cache() {
    rm -rf -- "$UV_CACHE_DIR"
}
trap cleanup_uv_cache 0

check_python_environment() {
    CHECK_STATUS=0
    CHECK_OUTPUT="$("$UV" pip check --color never --python "$VENV_DIR/bin/python" 2>&1)" || CHECK_STATUS=$?
    if [ "$CHECK_STATUS" -eq 0 ]; then
        printf '%s\n' "$CHECK_OUTPUT"
        return 0
    fi

    # NVIDIA's official 0.8.1 ARM64 wheel is named manylinux2014_aarch64,
    # but its internal WHEEL metadata declares an SBSA tag. uv correctly
    # reports that metadata mismatch even though the payload is the vendor's
    # supported ARM64 build. Permit only this exact, locked Jetson exception.
    INCOMPATIBILITY_COUNT="$(printf '%s\n' "$CHECK_OUTPUT" | grep -c '^The package ' || true)"
    if [ "$(uname -m)" = "aarch64" ] && \
        [ "$INCOMPATIBILITY_COUNT" -eq 1 ] && \
        printf '%s\n' "$CHECK_OUTPUT" | grep -Fqx \
            'The package `nvidia-cusparselt-cu13` was built for a different platform' && \
        "$VENV_DIR/bin/python" -c \
            'from importlib.metadata import distribution, version; wheel = distribution("nvidia-cusparselt-cu13").read_text("WHEEL") or ""; raise SystemExit(version("nvidia-cusparselt-cu13") != "0.8.1" or "_sbsa" not in wheel)'; then
        echo "WARNING: accepting NVIDIA nvidia-cusparselt-cu13 0.8.1 ARM64/SBSA wheel-tag mismatch" >&2
        return 0
    fi

    printf '%s\n' "$CHECK_OUTPUT" >&2
    return "$CHECK_STATUS"
}

case "${1:-}" in
    configure)
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        # Error-unwind calls must not reinstall packages, access the network,
        # or invent a new service policy. Restore state saved by prerm.
        systemctl daemon-reload 2>/dev/null || true
        if [ -e "$UPGRADE_STATE_DIR/enabled" ]; then
            systemctl enable "$SERVICE" 2>/dev/null || true
        fi
        if [ -e "$UPGRADE_STATE_DIR/active" ]; then
            systemctl start "$SERVICE" 2>/dev/null || true
        fi
        rm -rf -- "$UPGRADE_STATE_DIR"
        exit 0
        ;;
    *)
        exit 0
        ;;
esac

WAS_ENABLED=0
WAS_ACTIVE=0
WAS_MASKED=0
if [ -z "${2:-}" ]; then
    # Match the other QTrobot service packages on a clean installation.
    WAS_ENABLED=1
    WAS_ACTIVE=1
else
    if [ -e "$UPGRADE_STATE_DIR/enabled" ] || systemctl is-enabled --quiet "$SERVICE" 2>/dev/null; then
        WAS_ENABLED=1
    fi
    if [ -e "$UPGRADE_STATE_DIR/active" ] || systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
        WAS_ACTIVE=1
    fi
fi
ENABLE_STATE="$(systemctl is-enabled "$SERVICE" 2>/dev/null || true)"
if [ -e "$UPGRADE_STATE_DIR/masked" ] || [ "$ENABLE_STATE" = "masked" ]; then
    WAS_MASKED=1
    WAS_ENABLED=0
    WAS_ACTIVE=0
fi

mkdir -p \
    "$INSTALL_DIR/models/huggingface" \
    "$INSTALL_DIR/models/nltk_data"

systemctl daemon-reload
# Never run a service while its environment is being replaced.
systemctl stop "$SERVICE" 2>/dev/null || true

if [ -x "$VENV_DIR/bin/python" ] && \
    ! "$VENV_DIR/bin/python" -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 12))'; then
    echo "Replacing incompatible LuxAI S2S MAGPIE virtual environment..."
    rm -rf -- "$VENV_DIR"
fi

if [ ! -x "$VENV_DIR/bin/python" ]; then
    echo "Creating LuxAI S2S MAGPIE virtual environment..."
    "$UV" venv --python /usr/bin/python3.12 --no-python-downloads "$VENV_DIR"
fi

WHEEL_FILE="$(find "$INSTALL_DIR/packages" -maxdepth 1 -type f \
    -name 'luxai_s2s_magpie-*.whl' -print -quit)"
if [ -z "$WHEEL_FILE" ]; then
    echo "LuxAI S2S MAGPIE application wheel is missing" >&2
    exit 1
fi

echo "Installing LuxAI S2S MAGPIE dependencies..."
"$UV" pip sync --python "$VENV_DIR/bin/python" "$LOCK_FILE"
"$UV" pip install --python "$VENV_DIR/bin/python" \
    --no-deps --force-reinstall "$WHEEL_FILE"
check_python_environment

ASSETS_READY=0
if "$INSTALL_DIR/bin/luxai-s2s-magpie-provision" --verify-only; then
    ASSETS_READY=1
else
    echo "Pinned model assets are incomplete; attempting to download them..."
    if "$INSTALL_DIR/bin/luxai-s2s-magpie-provision"; then
        if "$INSTALL_DIR/bin/luxai-s2s-magpie-provision" --verify-only; then
            ASSETS_READY=1
        fi
    fi
fi

if [ "$ASSETS_READY" -eq 1 ]; then
    if [ "$WAS_MASKED" -eq 1 ]; then
        systemctl stop "$SERVICE" 2>/dev/null || true
    elif [ "$WAS_ENABLED" -eq 1 ]; then
        systemctl enable "$SERVICE"
    else
        systemctl disable "$SERVICE" 2>/dev/null || true
    fi
    if [ "$WAS_ACTIVE" -eq 1 ]; then
        systemctl restart "$SERVICE"
    else
        systemctl stop "$SERVICE" 2>/dev/null || true
    fi
else
    systemctl stop "$SERVICE" 2>/dev/null || true
    # A service that cannot pass ExecStartPre must never be left enabled.
    # Preserve an administrator mask, otherwise disable it until the explicit
    # provisioning command succeeds.
    if [ "$WAS_MASKED" -eq 0 ]; then
        systemctl disable "$SERVICE" 2>/dev/null || true
    fi
    echo >&2
    echo "LuxAI S2S MAGPIE was installed, but its model assets could not be provisioned." >&2
    echo "The service has not been started. With network access, run:" >&2
    echo "  sudo $INSTALL_DIR/bin/luxai-s2s-magpie-provision" >&2
    echo "  sudo systemctl enable --now $SERVICE" >&2
fi

rm -rf -- "$UPGRADE_STATE_DIR"
exit 0
